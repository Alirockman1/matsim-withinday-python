<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE config SYSTEM "./dtd/config_v2.dtd">

<config>
    <module name="agentModeChoice">
        <param name="modelType" value="QLearning" />
        <param name="loadCheckpoint" value="" />

        <!-- Berlin's traffic analysis zones in the scenario coordinate system (EPSG:25832),
             generated by berlin.java.prepare.PrepareBerlinTaz. -->
        <param name="TAZFileName" value="berlin-taz.shp" />
        <param name="autoEncoderModel" value="" />

        <param name="saveInterval" value="1" />
        <param name="validationInterval" value="40" />
        <param name="trainingCutoffIteration" value="800" />

        <param name="alpha" value="0.1" />
        <param name="gamma" value="0.9" />
        <param name="epsilon" value="0.9" />
        <param name="epsilonMinimum" value="0.05" />
        <param name="epsilonDecay" value="0.9995" />

        <param name="discontinuityPenalty" value="1.0" />
        <param name="retrievalCostPenalty" value="1.5" />
    </module>
</config>
